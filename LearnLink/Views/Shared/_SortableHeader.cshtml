@using Microsoft.AspNetCore.WebUtilities
@model SortableHeaderViewModel

@{
    var query = new Dictionary<string, string?>(
        Model.Filters.Where(f => !string.IsNullOrEmpty(f.Value)).ToDictionary(f => f.Key, f => f.Value))
    {
        ["sortBy"] = Model.Column,
        ["sortDescending"] = Model.NextDescending ? "true" : "false",
        ["pageSize"] = Model.PageSize.ToString(),
        [Model.PageParameter] = "1"
    };

    var href = QueryHelpers.AddQueryString(Context.Request.Path, query);
    var label = Model.IsActive ? $"{Model.Label} {Model.Indicator}" : Model.Label;
}

<th>
    <a class="text-decoration-none text-dark" href="@href"
       aria-label="Sort by @Model.Label">@label</a>
</th>
