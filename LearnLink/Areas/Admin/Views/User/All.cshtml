@using System.Security.Claims
@model UserListViewModel

@{
    ViewData["Title"] = "Users";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="text-center">
    <h2>@ViewData["Title"]</h2>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <form method="get" action="@Url.Action("All")">
        <input type="text" name="searchString" placeholder="Search by name or email" value="@Model.SearchString" />
        <button type="submit">Search</button>
    </form>
    <a asp-action="Add" class="btn btn-warning">Add New User</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Full Name</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.FullName</td>
                <td>@string.Join(", ", user.Roles)</td>
                <td>
                    <div class="row">
                        <div class="col">
                            <form asp-controller="User" asp-action="ChangeRole" method="post"
                                  onsubmit="return confirmAction('Are you sure you want to change the role?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@user.Id" />
                                <select name="roleName" class="form-control">
                                    <option value="">-- Select Role --</option>
                                    @foreach (var role in Model.RoleOptions)
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-primary">Assign</button>
                            </form>
                        </div>
                        <div class="col">
                            <form asp-controller="User" asp-action="UnassignRole" method="post"
                                  onsubmit="return confirmAction('Are you sure you want to unassign the role?');" asp-antiforgery="true">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-danger">Unassign</button>
                            </form>
                        </div>
                        <div class="col">
                            @if (user.Id != currentUserId)
                            {
                                <a asp-controller="User" asp-action="Delete" asp-route-id="@user.Id" class="btn btn-outline-danger">Delete</a>
                            }
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalCount == 0)
{
    <p>No users found.</p>
}
else
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="?searchString=@Model.SearchString&page=@i&pageSize=@Model.PageSize">@i</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <script>
        function confirmAction(message) {
            return confirm(message);
        }
    </script>
}
