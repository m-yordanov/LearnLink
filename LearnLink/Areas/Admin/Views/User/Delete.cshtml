@model UserDeleteViewModel
@{
    ViewData["Title"] = "Delete User";
}

<h2 class="text-center">@ViewData["Title"]</h2>
<hr />

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title text-center">User</h3>
                <p class="mb-0"><strong>Full Name:</strong> @Model.FullName</p>
                <p class="mb-0"><strong>Email:</strong> @Model.Email</p>
                <p class="mb-0"><strong>Role:</strong> @string.Join(", ", Model.Roles)</p>

                @if (Model.GradesCount > 0 || Model.AttendancesCount > 0)
                {
                    <p class="text-danger mt-3 mb-0">
                        Deleting this user will also delete @Model.GradesCount grade(s) and @Model.AttendancesCount attendance(s) linked to them.
                    </p>
                }

                <p class="text-danger mt-3">Are you sure you want to delete this user?</p>
            </div>
            <div class="card-footer">
                <form asp-action="DeleteConfirmed" method="post" asp-antiforgery="true">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                    <a asp-action="All" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
