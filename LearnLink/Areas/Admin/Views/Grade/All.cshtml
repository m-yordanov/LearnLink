@model GradeViewModel
@{
    ViewData["Title"] = "Grades";
}

@{
    var filters = new Dictionary<string, string?>
    {
        ["selectedStudent"] = Model.SelectedStudent,
        ["selectedTeacher"] = Model.SelectedTeacher,
        ["selectedSubject"] = Model.SelectedSubject,
        ["dateBefore"] = Model.DateBefore != DateTime.MinValue ? Model.DateBefore.ToString("yyyy-MM-dd") : null,
        ["dateAfter"] = Model.DateAfter != DateTime.MinValue ? Model.DateAfter.ToString("yyyy-MM-dd") : null,
        ["sortBy"] = Model.SortBy,
        ["sortDescending"] = Model.SortDescending ? "true" : "false"
    };
}

<h2 class="text-center">@ViewData["Title"]</h2>

<button id="toggleFilters" class="btn btn-primary">Filters</button>

<div id="filterSection" style="display: none;">
    <form method="get" id="filterForm" asp-action="All" asp-controller="Grade">
        <div class="form-row">
            <div class="form-group col-md-3">
                <label asp-for="SelectedStudent">Student</label>
                <input asp-for="SelectedStudent" class="form-control" />
            </div>
            <div class="form-group col-md-3">
                <label asp-for="SelectedTeacher">Teacher</label>
                <input asp-for="SelectedTeacher" class="form-control" />
            </div>
            <div class="form-group col-md-3">
                <label asp-for="SelectedSubject">Subject</label>
                <select asp-for="SelectedSubject" class="form-control">
                    <option value="">-- Select Subject --</option>
                    @foreach (var subject in Model.SubjectOptions)
                    {
                        <option value="@subject.Value">@subject.Text</option>
                    }
                </select>
            </div>
            <div class="form-group col-md-3">
                <label asp-for="DateAfter">After Date</label>
                <input asp-for="DateAfter" class="form-control" type="date" value="@((Model.DateAfter != DateTime.MinValue) ? Model.DateAfter.ToString("yyyy-MM-dd") : string.Empty)" />
            </div>
            <div class="form-group col-md-3">
                <label asp-for="DateBefore">Before Date</label>
                <input asp-for="DateBefore" class="form-control" type="date" value="@((Model.DateBefore != DateTime.MinValue) ? Model.DateBefore.ToString("yyyy-MM-dd") : string.Empty)" />
            </div>
        </div>
            <input type="hidden" name="sortBy" value="@Model.SortBy" />
            <input type="hidden" name="sortDescending" value="@(Model.SortDescending ? "true" : "false")" />
        <div class="form-group col-md-3">
            <button type="button" id="applyFilters" class="btn btn-success">Apply</button>
            <a class="btn btn-danger" asp-area="Admin" asp-controller="Grade" asp-action="All">Clear</a>
        </div>
    </form>
</div>

<table class="table">
    <thead>
        <tr>
            <partial name="_SortableHeader" model="@(new SortableHeaderViewModel
            {
                Column = "student",
                Label = "Student",
                CurrentSortBy = Model.SortBy,
                CurrentSortDescending = Model.SortDescending,
                DefaultDescending = false,
                PageSize = Model.PageSize,
                Filters = filters
            })" />
            <partial name="_SortableHeader" model="@(new SortableHeaderViewModel
            {
                Column = "teacher",
                Label = "Teacher",
                CurrentSortBy = Model.SortBy,
                CurrentSortDescending = Model.SortDescending,
                DefaultDescending = false,
                PageSize = Model.PageSize,
                Filters = filters
            })" />
            <partial name="_SortableHeader" model="@(new SortableHeaderViewModel
            {
                Column = "subject",
                Label = "Subject",
                CurrentSortBy = Model.SortBy,
                CurrentSortDescending = Model.SortDescending,
                DefaultDescending = false,
                PageSize = Model.PageSize,
                Filters = filters
            })" />
            <partial name="_SortableHeader" model="@(new SortableHeaderViewModel
            {
                Column = "value",
                Label = "Value",
                CurrentSortBy = Model.SortBy,
                CurrentSortDescending = Model.SortDescending,
                DefaultDescending = true,
                PageSize = Model.PageSize,
                Filters = filters
            })" />
            <partial name="_SortableHeader" model="@(new SortableHeaderViewModel
            {
                Column = "date",
                Label = "Date",
                CurrentSortBy = Model.SortBy,
                CurrentSortDescending = Model.SortDescending,
                DefaultDescending = true,
                PageSize = Model.PageSize,
                Filters = filters
            })" />
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var grade in Model.FilteredGrades)
        {
            <tr>
                <td>@grade.StudentFirstName @grade.StudentLastName</td>
                <td>@grade.TeacherFirstName @grade.TeacherLastName</td>
                <td>@grade.Subject</td>
                <td>@grade.Value</td>
                <td>@grade.DateAndTime.ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    <a asp-controller="Grade" asp-action="Edit" asp-route-id="@grade.Id" class="btn btn-warning">Edit</a>
                    <a asp-controller="Grade" asp-action="Delete" asp-route-id="@grade.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalCount == 0)
{
    <p>No grades found.</p>
}
else
{
    <partial name="_Pagination" model="@(new PaginationViewModel
    {
        PageNumber = Model.PageNumber,
        TotalPages = Model.TotalPages,
        PageSize = Model.PageSize,
        PageParameter = "pageNumber",
        Filters = filters
    })" />
}
<script>
    document.getElementById("toggleFilters").addEventListener("click", function () {
        var filterSection = document.getElementById("filterSection");
        if (filterSection.style.display === "none") {
            filterSection.style.display = "block";
        } else {
            filterSection.style.display = "none";
        }
    });

    document.getElementById("applyFilters").addEventListener("click", function () {
        document.getElementById("filterForm").submit();
    });
</script>



